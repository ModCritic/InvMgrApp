[Desktop Entry]
# InvMgr's menu entry, from its .deb or .rpm. jpackage writes in the app's name, description,
# launcher and icon when it builds the package. StartupWMClass is the X11 class JavaFX gives
# InvMgr's windows, its Application class's name; the dock matches the running app to this entry by it.
Type=Application
Name=APPLICATION_NAME
Comment=APPLICATION_DESCRIPTION
Exec=APPLICATION_LAUNCHER
Icon=APPLICATION_ICON
Categories=Utility;
Terminal=false
StartupWMClass=com.modcritic.invmgr.App
